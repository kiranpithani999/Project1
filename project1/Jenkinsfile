pipeline {
    agent { label 'node1' }

    parameters {
        choice(name: 'ACTION', choices: ['plan', 'apply', 'destroy'], description: 'Terraform Action')
        string(name: 'CONFIRM_DESTROY', defaultValue: '', description: 'Type YES to allow destroy')
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/kiranpithani999/Project1.git'
            }
        }

        stage('Terraform Init') {
            steps {
                dir('project1/Terraform') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('project1/Terraform') {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            when { expression { params.ACTION == 'plan' } }
            steps {
                dir('project1/Terraform') {
                    sh 'terraform plan'
                }
            }
        }

        stage('Terraform Apply') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                dir('project1/Terraform') {
                    sh 'terraform apply -auto-approve'
                }
            }
        }

        stage('Terraform Destroy') {
            when {
                allOf {
                    expression { params.ACTION == 'destroy' }
                    expression { params.CONFIRM_DESTROY == 'YES' }
                }
            }
            steps {
                dir('project1/Terraform') {
                    sh 'terraform destroy -auto-approve'
                }
            }
        }

        stage('Destroy Blocked') {
            when {
                allOf {
                    expression { params.ACTION == 'destroy' }
                    expression { params.CONFIRM_DESTROY != 'YES' }
                }
            }
            steps {
                echo 'Destroy blocked — type YES in CONFIRM_DESTROY'
            }
        }
    }

    post {
        success {
            echo 'Terraform execution successful'
        }
        failure {
            echo 'Terraform execution failed'
        }
    }
}